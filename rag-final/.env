# ═══════════════════════════════════════════════════════════════════════════════
# Adaptive RAG — Environment Variables
# FREE VERSION: Groq (chat) + Ollama (embeddings)
# ═══════════════════════════════════════════════════════════════════════════════
#
# SETUP STEPS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in MANDATORY values below
#   3. Run: docker compose up -d

# ── MANDATORY ──────────────────────────────────────────────────────────────────

# Your GROQ API key (NOT OpenAI — Groq is completely free)
# Get it at: https://console.groq.com  (no credit card required)
# The variable is still named OPENAI_API_KEY to avoid changing any Java code


# JWT signing secret — generate with:  openssl rand -base64 48


# PostgreSQL credentials — choose any values you want
DB_USERNAME=raguser
DB_PASSWORD=ragpassword123

# Redis password — choose any value you want
REDIS_PASSWORD=redispass123

# ── OLLAMA HOST (important for Docker) ────────────────────────────────────────
# Ollama runs on your HOST machine, not in Docker.
# The app container needs to reach it.
#
# macOS / Windows (Docker Desktop):
OLLAMA_HOST=http://host.docker.internal:11434
#
# Linux — uncomment this and comment the line above:
# OLLAMA_HOST=http://172.17.0.1:11434
# (find your docker bridge IP with: ip route | grep docker0 | awk '{print $9}')

# ── OPTIONAL ───────────────────────────────────────────────────────────────────
# These have working defaults — only set them if you need to override

# DB_HOST=postgres          # default: postgres (docker service name)
# DB_PORT=5432              # default: 5432
# DB_NAME=adaptive_rag      # default: adaptive_rag
# REDIS_HOST=redis          # default: redis (docker service name)
# REDIS_PORT=6379           # default: 6379



# LocalStack S3 mock (only needed if you want to test file storage locally)
# S3_ENDPOINT_OVERRIDE=http://localstack:4566

# Jaeger tracing (monitoring profile only)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# Grafana credentials (monitoring profile only)
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin
